@model AcxiomCRM.ViewModels.Leads.LeadConvertViewModel
@{
    ViewData["Title"] = $"Convert Lead: {Model.LeadName}";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h2 class="h3 fw-bold text-dark mb-0">
                    <i class="bi bi-arrow-repeat text-success me-2"></i>Convert Lead to Customer & Opportunity
                </h2>
                <p class="text-muted small mb-0">Qualify prospect and promote lead into official customer and sales deal records.</p>
            </div>
            <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Cancel
            </a>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <form asp-action="Convert" method="post" id="convertLeadForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadCode" />
                    <input type="hidden" asp-for="LeadName" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Phone" />
                    <input type="hidden" asp-for="CompanyName" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4" role="alert"></div>

                    <!-- Step 1: Customer Profile Creation -->
                    <div class="card bg-light border-0 p-3 mb-4">
                        <div class="d-flex align-items-center mb-2">
                            <span class="badge bg-primary rounded-circle p-2 me-2">1</span>
                            <h5 class="fw-bold mb-0 text-dark">Customer Account will be created</h5>
                        </div>
                        <p class="text-muted small mb-3">The following customer profile will be registered automatically from the lead details:</p>
                        <div class="row g-2 small">
                            <div class="col-sm-6"><strong>Name:</strong> @Model.LeadName</div>
                            <div class="col-sm-6"><strong>Email:</strong> @Model.Email</div>
                            <div class="col-sm-6"><strong>Phone:</strong> @Model.Phone</div>
                            <div class="col-sm-6"><strong>Company:</strong> @(string.IsNullOrEmpty(Model.CompanyName) ? "Individual" : Model.CompanyName)</div>
                        </div>
                    </div>

                    <!-- Step 2: Sales Opportunity Setup -->
                    <div class="card border p-3 mb-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="d-flex align-items-center">
                                <span class="badge bg-success rounded-circle p-2 me-2">2</span>
                                <h5 class="fw-bold mb-0 text-dark">Create Sales Opportunity Deal</h5>
                            </div>
                            <div class="form-check form-switch fs-5">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="CreateOpportunity" id="toggleOpportunity" />
                            </div>
                        </div>

                        <div id="opportunityFields">
                            <div class="row g-3">
                                <div class="col-md-7">
                                    <label asp-for="OpportunityName" class="form-label fw-semibold">Opportunity Name <span class="text-danger">*</span></label>
                                    <input asp-for="OpportunityName" class="form-control" placeholder="e.g. Acme Corp Enterprise License" />
                                    <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-5">
                                    <label asp-for="OpportunityAmount" class="form-label fw-semibold">Deal Amount ($) <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="OpportunityAmount" class="form-control" type="number" step="0.01" min="0.01" />
                                    </div>
                                    <span asp-validation-for="OpportunityAmount" class="text-danger small"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="OpportunityStage" class="form-label fw-semibold">Initial Stage <span class="text-danger">*</span></label>
                                    <select asp-for="OpportunityStage" class="form-select">
                                        <option value="Qualification">Qualification</option>
                                        <option value="Proposal">Proposal</option>
                                        <option value="Negotiation">Negotiation</option>
                                    </select>
                                    <span asp-validation-for="OpportunityStage" class="text-danger small"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="Probability" class="form-label fw-semibold">Win Probability (%)</label>
                                    <div class="input-group">
                                        <input asp-for="Probability" class="form-control" type="number" min="0" max="100" />
                                        <span class="input-group-text">%</span>
                                    </div>
                                    <span asp-validation-for="Probability" class="text-danger small"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="ExpectedCloseDate" class="form-label fw-semibold">Expected Close Date <span class="text-danger">*</span></label>
                                    <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                                    <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle me-1"></i> Upon conversion, Lead <strong>@Model.LeadCode</strong> will be permanently marked as <strong>Converted</strong> and linked to the newly generated Customer record.
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-success px-4 shadow-sm">
                            <i class="bi bi-check-circle me-1"></i> Convert & Create Customer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('toggleOpportunity').addEventListener('change', function() {
            var oppDiv = document.getElementById('opportunityFields');
            if (this.checked) {
                oppDiv.style.display = 'block';
            } else {
                oppDiv.style.display = 'none';
            }
        });
    </script>
}
