@model AcxiomCRM.ViewModels.Leads.LeadCreateEditViewModel
@{
    ViewData["Title"] = "New Lead";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h2 class="h3 fw-bold text-dark mb-0">
                    <i class="bi bi-funnel text-primary me-2"></i>Capture New Lead
                </h2>
                <p class="text-muted small mb-0">Record a new sales lead, assign ownership, and define initial qualification parameters.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="createLeadForm" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4" role="alert"></div>

                    <div class="row g-4">
                        <!-- Contact Details -->
                        <div class="col-md-6 border-end-md">
                            <h5 class="fw-semibold text-primary mb-3">
                                <i class="bi bi-person-lines-fill me-2"></i>Lead Information
                            </h5>

                            <div class="mb-3">
                                <label asp-for="LeadName" class="form-label fw-semibold">Lead / Prospect Name <span class="text-danger">*</span></label>
                                <input asp-for="LeadName" class="form-control" placeholder="e.g. Alice Johnson" autofocus />
                                <span asp-validation-for="LeadName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control" placeholder="alice@example.com" type="email" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Phone" class="form-label fw-semibold">Phone Number <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="Phone" class="form-control" placeholder="10-digit mobile number" maxlength="10" />
                                </div>
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="CompanyName" class="form-label fw-semibold">Company / Organization</label>
                                <input asp-for="CompanyName" class="form-control" placeholder="Prospective company name" />
                                <span asp-validation-for="CompanyName" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Sales Qualification & Assignment -->
                        <div class="col-md-6">
                            <h5 class="fw-semibold text-primary mb-3">
                                <i class="bi bi-graph-up-arrow me-2"></i>Qualification & Assignment
                            </h5>

                            <div class="mb-3">
                                <label asp-for="Source" class="form-label fw-semibold">Lead Source <span class="text-danger">*</span></label>
                                <select asp-for="Source" class="form-select">
                                    <option value="Website">Website Form</option>
                                    <option value="Referral">Client Referral</option>
                                    <option value="Cold Call">Cold Outreach</option>
                                    <option value="LinkedIn">LinkedIn / Social</option>
                                    <option value="Partner">Channel Partner</option>
                                    <option value="Event">Trade Show / Event</option>
                                </select>
                                <span asp-validation-for="Source" class="text-danger small"></span>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-sm-6">
                                    <label asp-for="Status" class="form-label fw-semibold">Initial Status <span class="text-danger">*</span></label>
                                    <select asp-for="Status" class="form-select">
                                        <option value="New">New</option>
                                        <option value="Contacted">Contacted</option>
                                        <option value="Qualified">Qualified</option>
                                        <option value="Unqualified">Unqualified</option>
                                        <option value="Lost">Lost</option>
                                    </select>
                                    <span asp-validation-for="Status" class="text-danger small"></span>
                                </div>
                                <div class="col-sm-6">
                                    <label asp-for="Priority" class="form-label fw-semibold">Priority</label>
                                    <select asp-for="Priority" class="form-select">
                                        <option value="Low">Low</option>
                                        <option value="Medium" selected>Medium</option>
                                        <option value="High">High</option>
                                    </select>
                                    <span asp-validation-for="Priority" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ExpectedValue" class="form-label fw-semibold">Estimated Value ($) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="ExpectedValue" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="AssignedTo" class="form-label fw-semibold">Assign Ownership</label>
                                <select asp-for="AssignedTo" class="form-select" asp-items="Model.SalesExecutivesList">
                                    <option value="">-- Leave Unassigned --</option>
                                </select>
                                <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> Save Lead
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
