@model AcxiomCRM.ViewModels.Leads.LeadListViewModel
@{
    ViewData["Title"] = "Lead Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 fw-bold mb-0 text-dark">
            <i class="bi bi-funnel-fill text-primary me-2"></i>Sales Leads
        </h2>
        <p class="text-muted small mb-0">Capture prospective clients, manage qualification stages, and convert leads into deals.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Add New Lead
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card shadow-sm border-0 mb-4 bg-light">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by name, company, email, phone, code..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    @foreach (var val in Enum.GetValues(typeof(AcxiomCRM.Models.Enums.LeadStatus)))
                    {
                        var statusVal = (AcxiomCRM.Models.Enums.LeadStatus)val;
                        <option value="@statusVal" selected="@(Model.StatusFilter == statusVal)">@statusVal</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="assignedTo" class="form-select">
                    <option value="All">All Assigned Executives</option>
                    @foreach (var exec in Model.SalesExecutivesList)
                    {
                        <option value="@exec.Value" selected="@(Model.AssignedToFilter == exec.Value)">@exec.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                @if (!string.IsNullOrEmpty(Model.Search) || Model.StatusFilter.HasValue || (!string.IsNullOrEmpty(Model.AssignedToFilter) && Model.AssignedToFilter != "All"))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Filters">
                        <i class="bi bi-x-circle"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Lead List Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (!Model.Leads.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-funnel text-muted" style="font-size: 3rem;"></i>
                <h5 class="text-muted mt-3">No leads found.</h5>
                <p class="text-secondary small mb-3">Try adjusting your filters or capture a new sales lead.</p>
                <a asp-action="Create" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Add Lead
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase small text-muted">
                        <tr>
                            <th>Code</th>
                            <th>Lead Name</th>
                            <th>Contact</th>
                            <th>Company / Source</th>
                            <th>Status</th>
                            <th>Expected Value</th>
                            <th>Assigned To</th>
                            <th>Created</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Leads)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-secondary font-monospace">@l.LeadCode</span>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@l.LeadId" class="fw-bold text-decoration-none text-primary">
                                        @l.LeadName
                                    </a>
                                </td>
                                <td>
                                    <div><a href="mailto:@l.Email" class="text-secondary text-decoration-none small"><i class="bi bi-envelope me-1"></i>@l.Email</a></div>
                                    <div><a href="tel:@l.Phone" class="text-secondary text-decoration-none small"><i class="bi bi-telephone me-1"></i>@l.Phone</a></div>
                                </td>
                                <td>
                                    <div class="fw-semibold">@(string.IsNullOrEmpty(l.CompanyName) ? "-" : l.CompanyName)</div>
                                    <span class="badge bg-light text-dark border small">@l.Source</span>
                                </td>
                                <td>
                                    @switch (l.Status)
                                    {
                                        case AcxiomCRM.Models.Enums.LeadStatus.New:
                                            <span class="badge bg-info text-dark">New</span>
                                            break;
                                        case AcxiomCRM.Models.Enums.LeadStatus.Contacted:
                                            <span class="badge bg-primary">Contacted</span>
                                            break;
                                        case AcxiomCRM.Models.Enums.LeadStatus.Qualified:
                                            <span class="badge bg-success">Qualified</span>
                                            break;
                                        case AcxiomCRM.Models.Enums.LeadStatus.Unqualified:
                                            <span class="badge bg-warning text-dark">Unqualified</span>
                                            break;
                                        case AcxiomCRM.Models.Enums.LeadStatus.Converted:
                                            <span class="badge bg-success-subtle text-success border border-success">Converted</span>
                                            break;
                                        case AcxiomCRM.Models.Enums.LeadStatus.Lost:
                                            <span class="badge bg-danger-subtle text-danger border border-danger">Lost</span>
                                            break;
                                    }
                                </td>
                                <td class="fw-bold text-success">@l.ExpectedValue.ToString("C0")</td>
                                <td class="small">@l.AssignedToName</td>
                                <td class="small text-muted">@l.CreatedDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@l.LeadId" class="btn btn-outline-secondary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (l.Status != AcxiomCRM.Models.Enums.LeadStatus.Converted)
                                        {
                                            <a asp-action="Convert" asp-route-id="@l.LeadId" class="btn btn-outline-success" title="Convert to Customer/Opportunity">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@l.LeadId" class="btn btn-outline-primary" title="Edit Lead">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@l.LeadId" class="btn btn-outline-danger" title="Delete / Mark Lost">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@l.ConvertedCustomerId" class="btn btn-outline-info" title="View Converted Customer">
                                                <i class="bi bi-person-check"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            <div class="card-footer bg-white border-top d-flex flex-column flex-sm-row justify-content-between align-items-center py-3">
                <div class="small text-muted mb-2 mb-sm-0">
                    Showing <strong>@((Model.PageNumber - 1) * Model.PageSize + 1)</strong> to 
                    <strong>@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalItems))</strong> of 
                    <strong>@Model.TotalItems</strong> leads
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Lead list pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@(Model.PageNumber - 1)" 
                                   asp-route-search="@Model.Search" 
                                   asp-route-status="@Model.StatusFilter" 
                                   asp-route-assignedTo="@Model.AssignedToFilter" 
                                   asp-route-pageSize="@Model.PageSize">&laquo; Prev</a>
                            </li>

                            @for (var p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" asp-action="Index" 
                                       asp-route-page="@p" 
                                       asp-route-search="@Model.Search" 
                                       asp-route-status="@Model.StatusFilter" 
                                       asp-route-assignedTo="@Model.AssignedToFilter" 
                                       asp-route-pageSize="@Model.PageSize">@p</a>
                                </li>
                            }

                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@(Model.PageNumber + 1)" 
                                   asp-route-search="@Model.Search" 
                                   asp-route-status="@Model.StatusFilter" 
                                   asp-route-assignedTo="@Model.AssignedToFilter" 
                                   asp-route-pageSize="@Model.PageSize">Next &raquo;</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        }
    </div>
</div>
