@model AcxiomCRM.ViewModels.AuditLogs.AuditLogListViewModel
@{
    ViewData["Title"] = "System Audit Logs";
}

<!-- Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="h3 fw-bold text-dark mb-0">
                <i class="bi bi-shield-lock text-primary me-2"></i>Security & Audit Trail
            </h2>
            <span class="badge bg-dark-subtle text-dark border px-2 py-1">
                <i class="bi bi-lock-fill me-1"></i>Immutable
            </span>
            <span class="badge bg-danger-subtle text-danger border px-2 py-1">
                <i class="bi bi-person-fill-lock me-1"></i>Admin Only
            </span>
        </div>
        <p class="text-muted small mb-0">
            Forensic audit trail of all CRUD operations, authentication lifecycle, role modifications, and security events.
        </p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm btn-sm">
            <i class="bi bi-arrow-clockwise me-1"></i> Refresh Logs
        </a>
    </div>
</div>

<!-- Filter Toolbar Card -->
<div class="card shadow-sm border-0 mb-4 bg-light">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <!-- Search Keyword -->
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Keyword Search</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Record ID, IP, details..." />
                </div>
            </div>

            <!-- User Filter -->
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">User</label>
                <select name="userId" class="form-select form-select-sm">
                    <option value="">All Users</option>
                    @foreach (var u in Model.UsersList)
                    {
                        <option value="@u.Value" selected="@(Model.UserId == u.Value)">@u.Text</option>
                    }
                </select>
            </div>

            <!-- Action Filter -->
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Action</label>
                <select name="action" class="form-select form-select-sm">
                    <option value="">All Actions</option>
                    @foreach (var a in Model.ActionsList)
                    {
                        <option value="@a.Value" selected="@(Model.Action == a.Value)">@a.Text</option>
                    }
                </select>
            </div>

            <!-- Entity / Module Filter -->
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Module / Entity</label>
                <select name="entityName" class="form-select form-select-sm">
                    <option value="">All Modules</option>
                    @foreach (var e in Model.EntitiesList)
                    {
                        <option value="@e.Value" selected="@(Model.EntityName == e.Value)">@e.Text</option>
                    }
                </select>
            </div>

            <!-- From Date -->
            <div class="col-md-1">
                <label class="form-label small fw-semibold text-muted mb-1">From</label>
                <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>

            <!-- To Date -->
            <div class="col-md-1">
                <label class="form-label small fw-semibold text-muted mb-1">To</label>
                <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>

            <!-- Filter Buttons -->
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1" title="Apply Filter">
                    <i class="bi bi-funnel"></i>
                </button>
                @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.UserId) || !string.IsNullOrEmpty(Model.Action) || !string.IsNullOrEmpty(Model.EntityName) || Model.FromDate.HasValue || Model.ToDate.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Clear Filters">
                        <i class="bi bi-x-circle"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Audit Logs Table -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="card-title fw-bold mb-0 text-dark">
            <i class="bi bi-list-check me-2 text-primary"></i>Audit Log Entries
        </h5>
        <span class="badge bg-light text-dark border">
            Total Records: <strong>@Model.TotalItems</strong>
        </span>
    </div>
    <div class="card-body p-0">
        @if (!Model.AuditLogs.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-shield-check" style="font-size: 3rem;"></i>
                <h5 class="mt-3">No audit records found matching your filter criteria.</h5>
                <p class="small text-secondary">All system operations are recorded in real-time as users interact with the CRM.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-muted text-uppercase">
                        <tr>
                            <th>Timestamp (UTC)</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Module</th>
                            <th>Record ID</th>
                            <th>IP Address</th>
                            <th>Result</th>
                            <th class="text-end">Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.AuditLogs)
                        {
                            <tr>
                                <td class="small text-nowrap">
                                    <div class="fw-semibold text-dark">@log.CreatedDate.ToString("yyyy-MM-dd")</div>
                                    <div class="text-muted"><i class="bi bi-clock me-1"></i>@log.CreatedDate.ToString("HH:mm:ss")</div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(log.UserName))
                                    {
                                        <div class="fw-semibold text-dark"><i class="bi bi-person me-1"></i>@log.UserName</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">System</span>
                                    }
                                    @if (!string.IsNullOrEmpty(log.UserId) && log.UserId != log.UserName)
                                    {
                                        <div class="small text-muted font-monospace" style="font-size: 0.75rem;">@log.UserId</div>
                                    }
                                </td>
                                <td>
                                    @switch (log.Action)
                                    {
                                        case "Create":
                                            <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-plus-circle me-1"></i>Create</span>
                                            break;
                                        case "Update":
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-pencil me-1"></i>Update</span>
                                            break;
                                        case "Delete":
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-trash me-1"></i>Delete</span>
                                            break;
                                        case "Deactivate":
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"><i class="bi bi-pause-circle me-1"></i>Deactivate</span>
                                            break;
                                        case "LoginSuccess":
                                        case "Login":
                                            <span class="badge bg-info-subtle text-info border border-info-subtle"><i class="bi bi-box-arrow-in-right me-1"></i>Login</span>
                                            break;
                                        case "LoginFailed":
                                            <span class="badge bg-danger text-white"><i class="bi bi-exclamation-triangle me-1"></i>Login Failed</span>
                                            break;
                                        case "Logout":
                                            <span class="badge bg-secondary-subtle text-secondary border"><i class="bi bi-box-arrow-right me-1"></i>Logout</span>
                                            break;
                                        case "RoleChange":
                                        case "RoleAssigned":
                                        case "RoleRemoved":
                                            <span class="badge bg-dark text-white"><i class="bi bi-shield-shaded me-1"></i>@log.Action</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark border">@log.Action</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border fw-normal">@log.EntityName</span>
                                </td>
                                <td class="font-monospace small">
                                    @(string.IsNullOrEmpty(log.RecordId) ? "-" : log.RecordId)
                                </td>
                                <td class="small text-muted font-monospace">
                                    <i class="bi bi-globe me-1"></i>@log.IpAddress
                                </td>
                                <td>
                                    @if (log.Result == "Success")
                                    {
                                        <span class="badge bg-success">Success</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@log.Result</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@log.AuditLogId" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Inspect Audit Record">
                                        <i class="bi bi-eye me-1"></i> View Diff
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">
                Showing Page <strong>@Model.PageNumber</strong> of <strong>@Model.TotalPages</strong>
            </span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(Model.PageNumber - 1)"
                       asp-route-search="@Model.Search"
                       asp-route-userId="@Model.UserId"
                       asp-route-action="@Model.Action"
                       asp-route-entityName="@Model.EntityName"
                       asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                       asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))">Previous</a>
                </li>
                @for (var i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@i"
                           asp-route-search="@Model.Search"
                           asp-route-userId="@Model.UserId"
                           asp-route-action="@Model.Action"
                           asp-route-entityName="@Model.EntityName"
                           asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                           asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(Model.PageNumber + 1)"
                       asp-route-search="@Model.Search"
                       asp-route-userId="@Model.UserId"
                       asp-route-action="@Model.Action"
                       asp-route-entityName="@Model.EntityName"
                       asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                       asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
