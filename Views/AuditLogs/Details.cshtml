@model AcxiomCRM.Models.AuditLog
@{
    ViewData["Title"] = $"Audit Log Entry #{Model.AuditLogId}";
}

<!-- Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-action="Index">Audit Logs</a></li>
                <li class="breadcrumb-item active" aria-current="page">Entry #@Model.AuditLogId</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2">
            <h2 class="h3 fw-bold text-dark mb-0">
                Audit Record #@Model.AuditLogId
            </h2>
            <span class="badge bg-dark-subtle text-dark border"><i class="bi bi-lock-fill me-1"></i>Immutable</span>
            @if (Model.Result == "Success")
            {
                <span class="badge bg-success">Success</span>
            }
            else
            {
                <span class="badge bg-danger">@Model.Result</span>
            }
        </div>
        <p class="text-muted small mb-0 mt-1">
            Recorded on @Model.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss 'UTC'") from IP: <span class="font-monospace fw-semibold">@Model.IpAddress</span>
        </p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Audit Logs
        </a>
    </div>
</div>

<!-- Security Alert Notice -->
<div class="alert alert-info d-flex align-items-center mb-4 shadow-sm" role="alert">
    <i class="bi bi-shield-check fs-4 me-3 text-info"></i>
    <div class="small">
        <strong>Security & Privacy Policy Applied:</strong> Any sensitive attributes (including passwords, password hashes, security tokens, API keys, and session cookies) are automatically redacted before storage to preserve compliance and credential confidentiality.
    </div>
</div>

<!-- Metadata Card -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="card-title fw-bold mb-0 text-dark">
            <i class="bi bi-info-circle me-2 text-primary"></i>Event Metadata
        </h5>
    </div>
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">Action Type</dt>
            <dd class="col-sm-9 fw-bold">
                <span class="badge bg-primary px-2 py-1">@Model.Action</span>
            </dd>

            <dt class="col-sm-3 text-muted">Module / Entity</dt>
            <dd class="col-sm-9 fw-semibold">@Model.EntityName</dd>

            <dt class="col-sm-3 text-muted">Target Record ID</dt>
            <dd class="col-sm-9 font-monospace">@(string.IsNullOrEmpty(Model.RecordId) ? "N/A" : Model.RecordId)</dd>

            <dt class="col-sm-3 text-muted">Actor / User</dt>
            <dd class="col-sm-9">
                <span><i class="bi bi-person me-1"></i>@(Model.UserName ?? "System / Anonymous")</span>
                @if (!string.IsNullOrEmpty(Model.UserId) && Model.UserId != Model.UserName)
                {
                    <span class="text-muted font-monospace small ms-2">(@Model.UserId)</span>
                }
            </dd>

            <dt class="col-sm-3 text-muted">Client IP Address</dt>
            <dd class="col-sm-9 font-monospace">@Model.IpAddress</dd>

            <dt class="col-sm-3 text-muted">Result / Status</dt>
            <dd class="col-sm-9">@Model.Result</dd>

            @if (!string.IsNullOrEmpty(Model.Details))
            {
                <dt class="col-sm-3 text-muted">Event Details</dt>
                <dd class="col-sm-9 text-secondary">@Model.Details</dd>
            }
        </dl>
    </div>
</div>

<!-- Old Value vs New Value Diff -->
<div class="row g-4">
    <!-- Old Value (Before Mutation) -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-light py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="card-title fw-bold mb-0 text-muted">
                    <i class="bi bi-clock-history me-2"></i>Old Value (Before Change)
                </h6>
                <span class="badge bg-secondary-subtle text-secondary border">Previous State</span>
            </div>
            <div class="card-body p-3">
                @if (string.IsNullOrWhiteSpace(Model.OldValue))
                {
                    <div class="text-center py-4 text-muted fst-italic">
                        No previous state recorded (initial creation or non-mutating event).
                    </div>
                }
                else
                {
                    <pre class="bg-dark text-light p-3 rounded mb-0 small font-monospace" style="max-height: 400px; overflow-y: auto;"><code>@Model.OldValue</code></pre>
                }
            </div>
        </div>
    </div>

    <!-- New Value (After Mutation) -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-light py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="card-title fw-bold mb-0 text-success">
                    <i class="bi bi-check-circle me-2"></i>New Value (After Change)
                </h6>
                <span class="badge bg-success-subtle text-success border border-success-subtle">Current State</span>
            </div>
            <div class="card-body p-3">
                @if (string.IsNullOrWhiteSpace(Model.NewValue))
                {
                    <div class="text-center py-4 text-muted fst-italic">
                        No subsequent state recorded (deletion or non-mutating event).
                    </div>
                }
                else
                {
                    <pre class="bg-dark text-success-emphasis p-3 rounded mb-0 small font-monospace" style="max-height: 400px; overflow-y: auto; background-color: #1a1e21 !important; color: #75b798 !important;"><code>@Model.NewValue</code></pre>
                }
            </div>
        </div>
    </div>
</div>
