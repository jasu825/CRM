@model AcxiomCRM.ViewModels.Customers.CustomerCreateEditViewModel
@{
    ViewData["Title"] = $"Edit {Model.CustomerName}";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h2 class="h3 fw-bold text-dark mb-0">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Edit Customer
                </h2>
                <p class="text-muted small mb-0">Modify information for <strong class="text-dark">@Model.CustomerName</strong> (@Model.CustomerCode).</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Details" asp-route-id="@Model.CustomerId" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-eye me-1"></i> View Details
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.CustomerId" method="post" id="editCustomerForm" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CustomerId" />

                    <!-- Model-Level Validation Summary -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4" role="alert"></div>

                    <div class="row g-4">
                        <!-- Left Column: Primary Contact Details -->
                        <div class="col-md-6 border-end-md">
                            <h5 class="fw-semibold text-primary mb-3">
                                <i class="bi bi-person-badge me-2"></i>Primary Contact Details
                            </h5>

                            <div class="mb-3">
                                <label asp-for="CustomerCode" class="form-label fw-semibold">Customer Code</label>
                                <input asp-for="CustomerCode" class="form-control bg-light font-monospace" readonly />
                            </div>

                            <div class="mb-3">
                                <label asp-for="CustomerName" class="form-label fw-semibold">Customer Name <span class="text-danger">*</span></label>
                                <input asp-for="CustomerName" class="form-control" />
                                <span asp-validation-for="CustomerName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control" type="email" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Phone" class="form-label fw-semibold">Phone Number <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="Phone" class="form-control" maxlength="10" />
                                </div>
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="CompanyName" class="form-label fw-semibold">Company / Organization</label>
                                <input asp-for="CompanyName" class="form-control" />
                                <span asp-validation-for="CompanyName" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Right Column: Location & Status -->
                        <div class="col-md-6">
                            <h5 class="fw-semibold text-primary mb-3">
                                <i class="bi bi-geo-alt me-2"></i>Location & Account Status
                            </h5>

                            <div class="mb-3">
                                <label asp-for="Address" class="form-label fw-semibold">Street Address</label>
                                <input asp-for="Address" class="form-control" />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-sm-6">
                                    <label asp-for="City" class="form-label fw-semibold">City</label>
                                    <input asp-for="City" class="form-control" />
                                    <span asp-validation-for="City" class="text-danger small"></span>
                                </div>
                                <div class="col-sm-6">
                                    <label asp-for="State" class="form-label fw-semibold">State / Province</label>
                                    <input asp-for="State" class="form-control" />
                                    <span asp-validation-for="State" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Status" class="form-label fw-semibold">Account Status <span class="text-danger">*</span></label>
                                <select asp-for="Status" class="form-select">
                                    <option value="Active">Active</option>
                                    <option value="Inactive">Inactive</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Details" asp-route-id="@Model.CustomerId" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">
                            <i class="bi bi-save me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
