@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = $"Delete {Model.CustomerName}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="h5 fw-bold mb-0">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Deactivate or Delete Customer
                </h4>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning mb-4">
                    <strong>Warning:</strong> You are about to modify the record for <strong>@Model.CustomerName</strong> (<span class="font-monospace">@Model.CustomerCode</span>).
                    If this customer has historical deals or activities, the system will preserve data integrity by deactivating the account instead of permanently deleting it.
                </div>

                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Customer Code</dt>
                    <dd class="col-sm-8 font-monospace fw-bold">@Model.CustomerCode</dd>

                    <dt class="col-sm-4 text-muted">Customer Name</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.CustomerName</dd>

                    <dt class="col-sm-4 text-muted">Email Address</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4 text-muted">Phone Number</dt>
                    <dd class="col-sm-8">@Model.Phone</dd>

                    <dt class="col-sm-4 text-muted">Current Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.Status == "Active")
                        {
                            <span class="badge bg-success-subtle text-success border">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border">Inactive</span>
                        }
                    </dd>
                </dl>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>

                    @if (Model.Status == "Active")
                    {
                        <form asp-action="Deactivate" asp-route-id="@Model.CustomerId" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning px-4 text-dark shadow-sm">
                                <i class="bi bi-pause-circle me-1"></i> Deactivate Only
                            </button>
                        </form>
                    }

                    <form asp-action="Delete" asp-route-id="@Model.CustomerId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger px-4 shadow-sm">
                            <i class="bi bi-trash-fill me-1"></i> Confirm Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
