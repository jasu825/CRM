@model AcxiomCRM.ViewModels.Customers.CustomerDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Customer.CustomerName} - Details";
}

<!-- Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-secondary font-monospace fs-6">@Model.Customer.CustomerCode</span>
            <h2 class="h3 fw-bold text-dark mb-0">@Model.Customer.CustomerName</h2>
            @if (Model.Customer.Status == "Active")
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Active</span>
            }
            else
            {
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Inactive</span>
            }
        </div>
        <p class="text-muted small mb-0">
            Registered on @Model.Customer.CreatedDate.ToString("MMMM dd, yyyy")
            @if (Model.Customer.CreatedByUser != null)
            {
                <span>by <strong>@Model.Customer.CreatedByUser.FullName</strong></span>
            }
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Customer.CustomerId" class="btn btn-primary shadow-sm">
            <i class="bi bi-pencil me-1"></i> Edit Profile
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Customer.CustomerId" class="btn btn-outline-danger shadow-sm">
            <i class="bi bi-trash me-1"></i> Manage / Delete
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Master Information Card -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="card-title fw-bold mb-0 text-primary">
                    <i class="bi bi-person-lines-fill me-2"></i>Contact Details
                </h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5 text-muted small text-uppercase">Email</dt>
                    <dd class="col-7">
                        <a href="mailto:@Model.Customer.Email" class="text-decoration-none">
                            <i class="bi bi-envelope me-1"></i>@Model.Customer.Email
                        </a>
                    </dd>

                    <dt class="col-5 text-muted small text-uppercase">Phone</dt>
                    <dd class="col-7">
                        <a href="tel:@Model.Customer.Phone" class="text-decoration-none">
                            <i class="bi bi-telephone me-1"></i>@Model.Customer.Phone
                        </a>
                    </dd>

                    <dt class="col-5 text-muted small text-uppercase">Company</dt>
                    <dd class="col-7">@(string.IsNullOrEmpty(Model.Customer.CompanyName) ? "Individual" : Model.Customer.CompanyName)</dd>

                    <dt class="col-5 text-muted small text-uppercase">Address</dt>
                    <dd class="col-7">@(string.IsNullOrEmpty(Model.Customer.Address) ? "-" : Model.Customer.Address)</dd>

                    <dt class="col-5 text-muted small text-uppercase">City / State</dt>
                    <dd class="col-7">
                        @if (!string.IsNullOrEmpty(Model.Customer.City) || !string.IsNullOrEmpty(Model.Customer.State))
                        {
                            <span>@Model.Customer.City@(string.IsNullOrEmpty(Model.Customer.City) || string.IsNullOrEmpty(Model.Customer.State) ? "" : ", ")@Model.Customer.State</span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </dd>

                    <dt class="col-5 text-muted small text-uppercase">Last Modified</dt>
                    <dd class="col-7 small text-muted">
                        @(Model.Customer.ModifiedDate.HasValue ? Model.Customer.ModifiedDate.Value.ToString("yyyy-MM-dd HH:mm") : "Never")
                    </dd>
                </dl>
            </div>
        </div>

        <!-- Metric Badges -->
        <div class="card shadow-sm border-0">
            <div class="card-body p-3">
                <div class="row g-2 text-center">
                    <div class="col-4">
                        <div class="p-2 rounded bg-light border">
                            <h4 class="fw-bold mb-0 text-primary">@Model.Opportunities.Count()</h4>
                            <span class="small text-muted">Deals</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded bg-light border">
                            <h4 class="fw-bold mb-0 text-success">@Model.FollowUps.Count()</h4>
                            <span class="small text-muted">Follow-Ups</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded bg-light border">
                            <h4 class="fw-bold mb-0 text-info">@Model.Activities.Count()</h4>
                            <span class="small text-muted">Activities</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Associated Pipeline & History -->
    <div class="col-lg-8">
        <!-- Opportunities Section -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
                <h5 class="card-title fw-bold mb-0 text-primary">
                    <i class="bi bi-briefcase me-2"></i>Sales Opportunities
                </h5>
                <span class="badge bg-primary rounded-pill">@Model.Opportunities.Count()</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Opportunities.Any())
                {
                    <div class="p-4 text-center text-muted small">
                        No opportunities linked to this customer yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-muted text-uppercase">
                                <tr>
                                    <th>Deal Name</th>
                                    <th>Stage</th>
                                    <th>Amount</th>
                                    <th>Probability</th>
                                    <th>Close Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in Model.Opportunities)
                                {
                                    <tr>
                                        <td class="fw-semibold">@o.OpportunityName</td>
                                        <td><span class="badge bg-info-subtle text-info border">@o.Stage</span></td>
                                        <td class="fw-bold">@o.Amount.ToString("C")</td>
                                        <td>@o.Probability%</td>
                                        <td class="small text-muted">@o.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Follow-Ups Section -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
                <h5 class="card-title fw-bold mb-0 text-success">
                    <i class="bi bi-calendar-check me-2"></i>Scheduled Follow-Ups
                </h5>
                <span class="badge bg-success rounded-pill">@Model.FollowUps.Count()</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.FollowUps.Any())
                {
                    <div class="p-4 text-center text-muted small">
                        No follow-ups recorded for this customer.
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var f in Model.FollowUps)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <div class="fw-semibold">@f.Subject</div>
                                    <div class="small text-muted">
                                        <i class="bi bi-clock me-1"></i>@f.FollowUpDate.ToString("yyyy-MM-dd HH:mm") &bull;
                                        Type: <strong>@f.FollowUpType</strong>
                                    </div>
                                    @if (!string.IsNullOrEmpty(f.Remarks))
                                    {
                                        <div class="small text-secondary mt-1">@f.Remarks</div>
                                    }
                                </div>
                                <span class="badge @(f.Status == AcxiomCRM.Models.Enums.FollowUpStatus.Completed ? "bg-success" : "bg-warning text-dark")">
                                    @f.Status
                                </span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <!-- Activities Section -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
                <h5 class="card-title fw-bold mb-0 text-info">
                    <i class="bi bi-clock-history me-2"></i>Activities & Interactions
                </h5>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-info rounded-pill">@Model.Activities.Count()</span>
                    <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-plus-circle me-1"></i> Log Activity
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                @if (!Model.Activities.Any())
                {
                    <div class="p-4 text-center text-muted small">
                        No activity records (calls, meetings, emails) logged for this customer yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-muted text-uppercase">
                                <tr>
                                    <th>Type</th>
                                    <th>Subject</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in Model.Activities)
                                {
                                    <tr>
                                        <td>
                                            @switch (a.ActivityType)
                                            {
                                                case AcxiomCRM.Models.Enums.ActivityType.Call:
                                                    <span class="badge bg-primary-subtle text-primary border"><i class="bi bi-telephone-fill me-1"></i>Call</span>
                                                    break;
                                                case AcxiomCRM.Models.Enums.ActivityType.Meeting:
                                                    <span class="badge bg-success-subtle text-success border"><i class="bi bi-people-fill me-1"></i>Meeting</span>
                                                    break;
                                                case AcxiomCRM.Models.Enums.ActivityType.Email:
                                                    <span class="badge bg-info-subtle text-info border"><i class="bi bi-envelope-fill me-1"></i>Email</span>
                                                    break;
                                                case AcxiomCRM.Models.Enums.ActivityType.Task:
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border"><i class="bi bi-check2-square me-1"></i>Task</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="fw-semibold">
                                            <a asp-controller="Activities" asp-action="Details" asp-route-id="@a.ActivityId" class="text-dark text-decoration-none">
                                                @a.Subject
                                            </a>
                                        </td>
                                        <td class="small text-muted">@a.ActivityDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            <span class="badge @(a.Status == "Completed" ? "bg-success" : "bg-secondary")">@a.Status</span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="Activities" asp-action="Details" asp-route-id="@a.ActivityId" class="btn btn-sm btn-outline-secondary py-0 px-2" title="View Activity">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
