@model AcxiomCRM.ViewModels.Activities.ActivityCreateEditViewModel
@{
    ViewData["Title"] = "Log Activity";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h2 class="h3 fw-bold text-dark mb-0">
                    <i class="bi bi-clock-history text-primary me-2"></i>Log CRM Activity
                </h2>
                <p class="text-muted small mb-0">Record a phone call, meeting, email interaction, or pending task.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="createActivityForm" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4" role="alert"></div>

                    <!-- Activity Type Selection -->
                    <div class="mb-4">
                        <label class="form-label fw-bold d-block">Select Activity Type <span class="text-danger">*</span></label>
                        <div class="row g-2">
                            <div class="col-6 col-md-3">
                                <input type="radio" class="btn-check" name="ActivityType" id="typeCall" value="Call" checked="@(Model.ActivityType == AcxiomCRM.Models.Enums.ActivityType.Call)">
                                <label class="btn btn-outline-primary w-100 py-2 d-flex flex-column align-items-center" for="typeCall">
                                    <i class="bi bi-telephone fs-4 mb-1"></i> Phone Call
                                </label>
                            </div>
                            <div class="col-6 col-md-3">
                                <input type="radio" class="btn-check" name="ActivityType" id="typeMeeting" value="Meeting" checked="@(Model.ActivityType == AcxiomCRM.Models.Enums.ActivityType.Meeting)">
                                <label class="btn btn-outline-success w-100 py-2 d-flex flex-column align-items-center" for="typeMeeting">
                                    <i class="bi bi-people fs-4 mb-1"></i> Meeting
                                </label>
                            </div>
                            <div class="col-6 col-md-3">
                                <input type="radio" class="btn-check" name="ActivityType" id="typeEmail" value="Email" checked="@(Model.ActivityType == AcxiomCRM.Models.Enums.ActivityType.Email)">
                                <label class="btn btn-outline-info w-100 py-2 d-flex flex-column align-items-center" for="typeEmail">
                                    <i class="bi bi-envelope fs-4 mb-1"></i> Email
                                </label>
                            </div>
                            <div class="col-6 col-md-3">
                                <input type="radio" class="btn-check" name="ActivityType" id="typeTask" value="Task" checked="@(Model.ActivityType == AcxiomCRM.Models.Enums.ActivityType.Task)">
                                <label class="btn btn-outline-warning w-100 py-2 d-flex flex-column align-items-center" for="typeTask">
                                    <i class="bi bi-check2-square fs-4 mb-1"></i> Task / To-Do
                                </label>
                            </div>
                        </div>
                        <span asp-validation-for="ActivityType" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label asp-for="Subject" class="form-label fw-semibold">Subject / Purpose <span class="text-danger">*</span></label>
                            <input asp-for="Subject" class="form-control" placeholder="e.g. Discovery call regarding annual contract" autofocus />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ActivityDate" class="form-label fw-semibold">Date & Time <span class="text-danger">*</span></label>
                            <input asp-for="ActivityDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Association Section (Customer or Lead) -->
                    <div class="card bg-light border-0 p-3 mb-3">
                        <h6 class="fw-semibold text-primary mb-2">
                            <i class="bi bi-link-45deg me-1"></i>Associate With Customer or Lead
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="CustomerId" class="form-label fw-semibold">Link to Customer</label>
                                <select asp-for="CustomerId" class="form-select" asp-items="Model.CustomersList">
                                    <option value="">-- None / Select Customer --</option>
                                </select>
                                <span asp-validation-for="CustomerId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LeadId" class="form-label fw-semibold">Link to Sales Lead</label>
                                <select asp-for="LeadId" class="form-select" asp-items="Model.LeadsList">
                                    <option value="">-- None / Select Lead --</option>
                                </select>
                                <span asp-validation-for="LeadId" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label fw-semibold">Assigned Team Member</label>
                            <select asp-for="AssignedTo" class="form-select" asp-items="Model.SalesExecutivesList">
                                <option value="">-- Assign to Me / Unassigned --</option>
                            </select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold">Activity Status <span class="text-danger">*</span></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Completed">Completed</option>
                                <option value="Pending">Pending / Scheduled</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">Notes / Discussion Summary</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Detail notes, discussion points, action items, or call outcome..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> Save Activity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
