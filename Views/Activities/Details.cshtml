@model AcxiomCRM.Models.Activity
@{
    ViewData["Title"] = $"Activity - {Model.Subject}";
}

<!-- Header & Actions -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-action="Index">Activities</a></li>
                <li class="breadcrumb-item active" aria-current="page">Details</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @switch (Model.ActivityType)
            {
                case AcxiomCRM.Models.Enums.ActivityType.Call:
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fs-6">
                        <i class="bi bi-telephone-fill me-1"></i>Call
                    </span>
                    break;
                case AcxiomCRM.Models.Enums.ActivityType.Meeting:
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fs-6">
                        <i class="bi bi-people-fill me-1"></i>Meeting
                    </span>
                    break;
                case AcxiomCRM.Models.Enums.ActivityType.Email:
                    <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1 fs-6">
                        <i class="bi bi-envelope-fill me-1"></i>Email
                    </span>
                    break;
                case AcxiomCRM.Models.Enums.ActivityType.Task:
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 fs-6">
                        <i class="bi bi-check2-square me-1"></i>Task
                    </span>
                    break;
            }
            <h2 class="h3 fw-bold text-dark mb-0">@Model.Subject</h2>
            @if (Model.Status == "Completed")
            {
                <span class="badge bg-success">Completed</span>
            }
            else if (Model.Status == "Pending")
            {
                <span class="badge bg-warning text-dark">Pending</span>
            }
            else
            {
                <span class="badge bg-secondary">@Model.Status</span>
            }
        </div>
        <p class="text-muted small mb-0 mt-1">
            Recorded on @Model.CreatedDate.ToString("MMMM dd, yyyy 'at' HH:mm")
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.ActivityId" class="btn btn-primary shadow-sm">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.ActivityId" class="btn btn-outline-danger">
            <i class="bi bi-trash me-1"></i> Delete
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Main Information -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-card-text me-2 text-primary"></i>Activity Details
                </h5>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-3 text-muted">Activity Type</dt>
                    <dd class="col-sm-9 fw-semibold">@Model.ActivityType</dd>

                    <dt class="col-sm-3 text-muted">Subject</dt>
                    <dd class="col-sm-9 fw-bold text-dark">@Model.Subject</dd>

                    <dt class="col-sm-3 text-muted">Activity Date & Time</dt>
                    <dd class="col-sm-9">
                        <span class="fw-semibold"><i class="bi bi-calendar3 me-1 text-primary"></i>@Model.ActivityDate.ToString("MMMM dd, yyyy")</span>
                        <span class="text-muted ms-2"><i class="bi bi-clock me-1"></i>@Model.ActivityDate.ToString("hh:mm tt")</span>
                    </dd>

                    <dt class="col-sm-3 text-muted">Status</dt>
                    <dd class="col-sm-9">
                        @if (Model.Status == "Completed")
                        {
                            <span class="badge bg-success">Completed</span>
                        }
                        else if (Model.Status == "Pending")
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Model.Status</span>
                        }
                    </dd>

                    <dt class="col-sm-3 text-muted">Assigned To</dt>
                    <dd class="col-sm-9">
                        @if (Model.AssignedUser != null)
                        {
                            <span><i class="bi bi-person-check me-1 text-success"></i>@Model.AssignedUser.FullName <span class="text-muted">(@Model.AssignedUser.Email)</span></span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Unassigned</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <!-- Description / Meeting Notes Card -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-chat-left-text me-2 text-info"></i>Notes & Description
                </h5>
            </div>
            <div class="card-body p-4">
                @if (string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="text-muted fst-italic mb-0">No detailed notes or description entered for this activity.</p>
                }
                else
                {
                    <div class="bg-light p-3 rounded border text-secondary" style="white-space: pre-wrap; font-size: 0.95rem; line-height: 1.6;">@Model.Description</div>
                }
            </div>
        </div>
    </div>

    <!-- Related Associations Sidebar -->
    <div class="col-lg-4">
        <!-- Associated Entity Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-link-45deg me-2 text-primary"></i>Associated Record
                </h5>
            </div>
            <div class="card-body p-4">
                @if (Model.Customer != null)
                {
                    <div class="p-3 border rounded bg-primary-subtle border-primary-subtle mb-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge bg-primary">Customer</span>
                            <span class="font-monospace small text-muted">@Model.Customer.CustomerCode</span>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">@Model.Customer.CustomerName</h6>
                        @if (!string.IsNullOrEmpty(Model.Customer.CompanyName))
                        {
                            <div class="small text-muted mb-1"><i class="bi bi-building me-1"></i>@Model.Customer.CompanyName</div>
                        }
                        <div class="small text-muted mb-1"><i class="bi bi-envelope me-1"></i>@Model.Customer.Email</div>
                        @if (!string.IsNullOrEmpty(Model.Customer.Phone))
                        {
                            <div class="small text-muted mb-3"><i class="bi bi-telephone me-1"></i>@Model.Customer.Phone</div>
                        }
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="btn btn-sm btn-outline-primary w-100">
                            <i class="bi bi-person me-1"></i> View Customer Profile
                        </a>
                    </div>
                }
                else if (Model.Lead != null)
                {
                    <div class="p-3 border rounded bg-success-subtle border-success-subtle mb-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge bg-success">Lead</span>
                            <span class="font-monospace small text-muted">@Model.Lead.LeadCode</span>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">@Model.Lead.LeadName</h6>
                        @if (!string.IsNullOrEmpty(Model.Lead.CompanyName))
                        {
                            <div class="small text-muted mb-1"><i class="bi bi-building me-1"></i>@Model.Lead.CompanyName</div>
                        }
                        <div class="small text-muted mb-1"><i class="bi bi-envelope me-1"></i>@Model.Lead.Email</div>
                        @if (!string.IsNullOrEmpty(Model.Lead.Phone))
                        {
                            <div class="small text-muted mb-3"><i class="bi bi-telephone me-1"></i>@Model.Lead.Phone</div>
                        }
                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-sm btn-outline-success w-100">
                            <i class="bi bi-funnel me-1"></i> View Lead Details
                        </a>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-link-45deg fs-2 d-block mb-2"></i>
                        <span>This activity is a general internal task not directly linked to a Customer or Lead.</span>
                    </div>
                }
            </div>
        </div>

        <!-- Quick Actions Card -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-lightning-charge me-2 text-warning"></i>Quick Actions
                </h5>
            </div>
            <div class="card-body p-3 d-flex flex-column gap-2">
                @if (Model.CustomerId.HasValue)
                {
                    <a asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-outline-primary text-start">
                        <i class="bi bi-plus-circle me-2"></i>Log another activity for this Customer
                    </a>
                }
                @if (Model.LeadId.HasValue)
                {
                    <a asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-outline-success text-start">
                        <i class="bi bi-plus-circle me-2"></i>Log another activity for this Lead
                    </a>
                }
                <a asp-action="Create" class="btn btn-sm btn-outline-secondary text-start">
                    <i class="bi bi-clock-history me-2"></i>Log general activity
                </a>
            </div>
        </div>
    </div>
</div>
