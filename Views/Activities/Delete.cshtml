@model AcxiomCRM.Models.Activity
@{
    ViewData["Title"] = $"Delete Activity - {Model.Subject}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="h5 fw-bold mb-0">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Activity
                </h4>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning mb-4">
                    <strong>Warning:</strong> Are you sure you want to permanently delete this activity record? This action will remove the interaction log from the system and cannot be undone.
                </div>

                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Activity Type</dt>
                    <dd class="col-sm-8">
                        @switch (Model.ActivityType)
                        {
                            case AcxiomCRM.Models.Enums.ActivityType.Call:
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-telephone-fill me-1"></i>Call</span>
                                break;
                            case AcxiomCRM.Models.Enums.ActivityType.Meeting:
                                <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-people-fill me-1"></i>Meeting</span>
                                break;
                            case AcxiomCRM.Models.Enums.ActivityType.Email:
                                <span class="badge bg-info-subtle text-info border border-info-subtle"><i class="bi bi-envelope-fill me-1"></i>Email</span>
                                break;
                            case AcxiomCRM.Models.Enums.ActivityType.Task:
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"><i class="bi bi-check2-square me-1"></i>Task</span>
                                break;
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">Subject</dt>
                    <dd class="col-sm-8 fw-semibold text-dark">@Model.Subject</dd>

                    <dt class="col-sm-4 text-muted">Activity Date</dt>
                    <dd class="col-sm-8">@Model.ActivityDate.ToString("yyyy-MM-dd HH:mm")</dd>

                    <dt class="col-sm-4 text-muted">Associated With</dt>
                    <dd class="col-sm-8">
                        @if (Model.Customer != null)
                        {
                            <span class="badge bg-light text-primary border"><i class="bi bi-person me-1"></i>Customer: @Model.Customer.CustomerName</span>
                        }
                        else if (Model.Lead != null)
                        {
                            <span class="badge bg-light text-success border"><i class="bi bi-funnel me-1"></i>Lead: @Model.Lead.LeadName</span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">None (General Activity)</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">Assigned To</dt>
                    <dd class="col-sm-8">
                        @if (Model.AssignedUser != null)
                        {
                            <span>@Model.AssignedUser.FullName</span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Unassigned</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">Status</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-secondary">@Model.Status</span>
                    </dd>
                </dl>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>

                    <form asp-action="Delete" asp-route-id="@Model.ActivityId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger px-4 shadow-sm">
                            <i class="bi bi-trash me-1"></i> Confirm Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
