@model AcxiomCRM.ViewModels.Activities.ActivityListViewModel
@{
    ViewData["Title"] = "Activity Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 fw-bold mb-0 text-dark">
            <i class="bi bi-clock-history text-primary me-2"></i>Activities
        </h2>
        <p class="text-muted small mb-0">Track and log customer interactions including Calls, Meetings, Emails, and Tasks.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Log Activity
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card shadow-sm border-0 mb-4 bg-light">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search subject, notes, customer..." />
                </div>
            </div>
            <div class="col-md-2">
                <select name="type" class="form-select">
                    <option value="">All Types</option>
                    @foreach (var val in Enum.GetValues(typeof(AcxiomCRM.Models.Enums.ActivityType)))
                    {
                        var t = (AcxiomCRM.Models.Enums.ActivityType)val;
                        <option value="@t" selected="@(Model.TypeFilter == t)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="All">All Statuses</option>
                    <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                    <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
                    <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="customerId" class="form-select">
                    <option value="">All Customers</option>
                    @foreach (var c in Model.CustomersList)
                    {
                        <option value="@c.Value" selected="@(Model.CustomerIdFilter?.ToString() == c.Value)">@c.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                @if (!string.IsNullOrEmpty(Model.Search) || Model.TypeFilter.HasValue || (!string.IsNullOrEmpty(Model.StatusFilter) && Model.StatusFilter != "All") || Model.CustomerIdFilter.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Filters">
                        <i class="bi bi-x-circle"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Activities Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (!Model.Activities.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
                <h5 class="text-muted mt-3">No activities recorded.</h5>
                <p class="text-secondary small mb-3">Log your client calls, meetings, emails, or to-do tasks.</p>
                <a asp-action="Create" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Log Activity
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase small text-muted">
                        <tr>
                            <th>Type</th>
                            <th>Subject</th>
                            <th>Associated With</th>
                            <th>Activity Date</th>
                            <th>Assigned To</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Activities)
                        {
                            <tr>
                                <td>
                                    @switch (a.ActivityType)
                                    {
                                        case AcxiomCRM.Models.Enums.ActivityType.Call:
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-telephone-fill me-1"></i>Call</span>
                                            break;
                                        case AcxiomCRM.Models.Enums.ActivityType.Meeting:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-people-fill me-1"></i>Meeting</span>
                                            break;
                                        case AcxiomCRM.Models.Enums.ActivityType.Email:
                                            <span class="badge bg-info-subtle text-info border border-info-subtle"><i class="bi bi-envelope-fill me-1"></i>Email</span>
                                            break;
                                        case AcxiomCRM.Models.Enums.ActivityType.Task:
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"><i class="bi bi-check2-square me-1"></i>Task</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@a.ActivityId" class="fw-bold text-decoration-none text-dark">
                                        @a.Subject
                                    </a>
                                    @if (!string.IsNullOrEmpty(a.Description))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width: 280px;">@a.Description</div>
                                    }
                                </td>
                                <td>
                                    @if (a.CustomerId.HasValue)
                                    {
                                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@a.CustomerId" class="badge bg-light text-primary border text-decoration-none">
                                            <i class="bi bi-person me-1"></i>Customer: @a.CustomerName
                                        </a>
                                    }
                                    else if (a.LeadId.HasValue)
                                    {
                                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@a.LeadId" class="badge bg-light text-success border text-decoration-none">
                                            <i class="bi bi-funnel me-1"></i>Lead: @a.LeadName
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td class="small">
                                    <div><i class="bi bi-calendar3 me-1"></i>@a.ActivityDate.ToString("yyyy-MM-dd")</div>
                                    <div class="text-muted"><i class="bi bi-clock me-1"></i>@a.ActivityDate.ToString("HH:mm")</div>
                                </td>
                                <td class="small">@a.AssignedToName</td>
                                <td>
                                    @if (a.Status == "Completed")
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                    else if (a.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@a.Status</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@a.ActivityId" class="btn btn-outline-secondary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@a.ActivityId" class="btn btn-outline-primary" title="Edit Activity">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@a.ActivityId" class="btn btn-outline-danger" title="Delete Activity">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            <div class="card-footer bg-white border-top d-flex flex-column flex-sm-row justify-content-between align-items-center py-3">
                <div class="small text-muted mb-2 mb-sm-0">
                    Showing <strong>@((Model.PageNumber - 1) * Model.PageSize + 1)</strong> to 
                    <strong>@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalItems))</strong> of 
                    <strong>@Model.TotalItems</strong> activities
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Activities pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@(Model.PageNumber - 1)" 
                                   asp-route-search="@Model.Search" 
                                   asp-route-type="@Model.TypeFilter" 
                                   asp-route-status="@Model.StatusFilter" 
                                   asp-route-customerId="@Model.CustomerIdFilter" 
                                   asp-route-pageSize="@Model.PageSize">&laquo; Prev</a>
                            </li>

                            @for (var p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" asp-action="Index" 
                                       asp-route-page="@p" 
                                       asp-route-search="@Model.Search" 
                                       asp-route-type="@Model.TypeFilter" 
                                       asp-route-status="@Model.StatusFilter" 
                                       asp-route-customerId="@Model.CustomerIdFilter" 
                                       asp-route-pageSize="@Model.PageSize">@p</a>
                                </li>
                            }

                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@(Model.PageNumber + 1)" 
                                   asp-route-search="@Model.Search" 
                                   asp-route-type="@Model.TypeFilter" 
                                   asp-route-status="@Model.StatusFilter" 
                                   asp-route-customerId="@Model.CustomerIdFilter" 
                                   asp-route-pageSize="@Model.PageSize">Next &raquo;</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        }
    </div>
</div>
