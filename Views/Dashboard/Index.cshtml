@model AcxiomCRM.ViewModels.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "CRM Dashboard";
}

<!-- Dashboard Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
    <div>
        <h2 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-speedometer2 text-primary me-2"></i>Executive Dashboard
        </h2>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                <i class="bi bi-person-badge me-1"></i>Role: @Model.UserRole
            </span>
            <span class="badge bg-light text-secondary border px-2 py-1">
                <i class="bi bi-shield-check me-1"></i>@Model.ScopeDescription
            </span>
            <span class="small text-muted ms-2">
                <i class="bi bi-clock me-1"></i>As of @DateTime.Now.ToString("dd MMM yyyy, HH:mm")
            </span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Leads" asp-action="Create" class="btn btn-primary shadow-sm btn-sm">
            <i class="bi bi-plus-circle me-1"></i> New Lead
        </a>
        <a asp-controller="Activities" asp-action="Create" class="btn btn-outline-primary shadow-sm btn-sm">
            <i class="bi bi-clock-history me-1"></i> Log Activity
        </a>
    </div>
</div>

<!-- ========================================== -->
<!-- 8 REQUIRED KPI METRIC CARDS (2 Rows x 4) -->
<!-- ========================================== -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">
    <!-- 1. Total Customers -->
    <div class="col">
        <div class="card h-100 shadow-sm border-0 border-start border-4 border-primary">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small fw-bold text-muted mb-1">Total Customers</div>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalCustomers</h3>
                    </div>
                    <div class="rounded-circle bg-primary-subtle p-3 text-primary">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-2 pt-2 border-top">
                    <a asp-controller="Customers" asp-action="Index" class="text-decoration-none small text-primary fw-semibold">
                        View Directory <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Total Leads -->
    <div class="col">
        <div class="card h-100 shadow-sm border-0 border-start border-4 border-info">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small fw-bold text-muted mb-1">Total Leads</div>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalLeads</h3>
                    </div>
                    <div class="rounded-circle bg-info-subtle p-3 text-info">
                        <i class="bi bi-funnel-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-2 pt-2 border-top">
                    <a asp-controller="Leads" asp-action="Index" class="text-decoration-none small text-info fw-semibold">
                        View All Prospects <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Open Leads -->
    <div class="col">
        <div class="card h-100 shadow-sm border-0 border-start border-4 border-warning">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small fw-bold text-muted mb-1">Open Leads</div>
                        <h3 class="fw-bold mb-0 text-dark">@Model.OpenLeads</h3>
                    </div>
                    <div class="rounded-circle bg-warning-subtle p-3 text-warning">
                        <i class="bi bi-lightning-charge-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-2 pt-2 border-top">
                    <span class="small text-muted">Active Pipeline Prospects</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Total Opportunities -->
    <div class="col">
        <div class="card h-100 shadow-sm border-0 border-start border-4 border-secondary">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small fw-bold text-muted mb-1">Total Opportunities</div>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalOpportunities</h3>
                    </div>
                    <div class="rounded-circle bg-secondary-subtle p-3 text-secondary">
                        <i class="bi bi-briefcase-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-2 pt-2 border-top">
                    <span class="small text-muted">All Pipeline Deals</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. Open Opportunities -->
    <div class="col">
        <div class="card h-100 shadow-sm border-0 border-start border-4 border-primary">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small fw-bold text-muted mb-1">Open Opportunities</div>
                        <h3 class="fw-bold mb-0 text-primary">@Model.OpenOpportunities</h3>
                    </div>
                    <div class="rounded-circle bg-primary-subtle p-3 text-primary">
                        <i class="bi bi-folder-check fs-4"></i>
                    </div>
                </div>
                <div class="mt-2 pt-2 border-top">
                    <span class="small text-muted">In Qualification / Proposal / Negotiation</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 6. Won Opportunities -->
    <div class="col">
        <div class="card h-100 shadow-sm border-0 border-start border-4 border-success">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small fw-bold text-muted mb-1">Won Opportunities</div>
                        <h3 class="fw-bold mb-0 text-success">@Model.WonOpportunities</h3>
                    </div>
                    <div class="rounded-circle bg-success-subtle p-3 text-success">
                        <i class="bi bi-trophy-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-2 pt-2 border-top">
                    <span class="small text-success fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>Closed-Won Revenue</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 7. Lost Opportunities -->
    <div class="col">
        <div class="card h-100 shadow-sm border-0 border-start border-4 border-danger">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small fw-bold text-muted mb-1">Lost Opportunities</div>
                        <h3 class="fw-bold mb-0 text-danger">@Model.LostOpportunities</h3>
                    </div>
                    <div class="rounded-circle bg-danger-subtle p-3 text-danger">
                        <i class="bi bi-x-octagon-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-2 pt-2 border-top">
                    <span class="small text-muted">Closed-Lost Deals</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 8. Total Pipeline Value -->
    <div class="col">
        <div class="card h-100 shadow-sm border-0 border-start border-4 border-success bg-light">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small fw-bold text-muted mb-1">Total Pipeline Value</div>
                        <h3 class="fw-bold mb-0 text-success">@Model.TotalPipelineValue.ToString("C0")</h3>
                    </div>
                    <div class="rounded-circle bg-success text-white p-3">
                        <i class="bi bi-currency-dollar fs-4"></i>
                    </div>
                </div>
                <div class="mt-2 pt-2 border-top d-flex justify-content-between small">
                    <span class="text-muted">Weighted:</span>
                    <strong class="text-dark">@Model.WeightedPipelineValue.ToString("C0")</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- CHART.JS VISUALIZATIONS -->
<!-- ========================================== -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Lead Status Breakdown -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-pie-chart me-2 text-info"></i>Lead Status Breakdown
                </h5>
                <span class="badge bg-light text-muted border">@Model.TotalLeads Total</span>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center p-4">
                <div style="position: relative; width: 100%; max-width: 320px; height: 280px;">
                    <canvas id="leadStatusChart"></canvas>
                </div>
                <div class="mt-3 small text-muted text-center">
                    Distribution of active and converted sales leads.
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 2: Opportunity Pipeline by Stage -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-bar-chart-steps me-2 text-primary"></i>Opportunity Pipeline by Stage
                </h5>
                <span class="badge bg-light text-muted border">@Model.TotalOpportunities Deals</span>
            </div>
            <div class="card-body p-4">
                <div style="position: relative; width: 100%; height: 280px;">
                    <canvas id="opportunityPipelineChart"></canvas>
                </div>
                <div class="mt-3 small text-muted text-center">
                    Stage-by-stage opportunity volume and progression.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Row 2: Monthly Sales Performance -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-graph-up-arrow me-2 text-success"></i>Monthly Sales Performance
                </h5>
                <span class="badge bg-success-subtle text-success border border-success-subtle">
                    Last 6 Months
                </span>
            </div>
            <div class="card-body p-4">
                <div style="position: relative; width: 100%; height: 320px;">
                    <canvas id="monthlySalesChart"></canvas>
                </div>
                <div class="mt-3 small text-muted text-center">
                    Total closed-won sales revenue trend over recent monthly cycles.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js Library -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Safe JSON Data passed from DashboardViewModel
            const leadStatusData = @Html.Raw(Model.LeadStatusChartJson);
            const oppPipelineData = @Html.Raw(Model.OpportunityPipelineChartJson);
            const monthlySalesData = @Html.Raw(Model.MonthlySalesChartJson);

            // ==========================================
            // 1. LEAD STATUS DOUGHNUT CHART
            // ==========================================
            const leadCtx = document.getElementById('leadStatusChart');
            if (leadCtx) {
                new Chart(leadCtx, {
                    type: 'doughnut',
                    data: {
                        labels: leadStatusData.Labels,
                        datasets: [{
                            data: leadStatusData.Counts,
                            backgroundColor: leadStatusData.BackgroundColors,
                            borderWidth: 2,
                            borderColor: '#ffffff',
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    boxWidth: 12,
                                    padding: 12,
                                    font: { size: 11 }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const label = context.label || '';
                                        const value = context.parsed || 0;
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                        return ` ${label}: ${value} (${percentage}%)`;
                                    }
                                }
                            }
                        },
                        cutout: '65%'
                    }
                });
            }

            // ==========================================
            // 2. OPPORTUNITY PIPELINE BAR CHART
            // ==========================================
            const oppCtx = document.getElementById('opportunityPipelineChart');
            if (oppCtx) {
                new Chart(oppCtx, {
                    type: 'bar',
                    data: {
                        labels: oppPipelineData.Labels,
                        datasets: [
                            {
                                label: 'Deal Count',
                                data: oppPipelineData.Counts,
                                backgroundColor: oppPipelineData.BackgroundColors,
                                borderRadius: 6,
                                yAxisID: 'y'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                callbacks: {
                                    afterLabel: function(context) {
                                        const index = context.dataIndex;
                                        const amount = oppPipelineData.Amounts[index] || 0;
                                        return `Stage Value: $${amount.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                title: {
                                    display: true,
                                    text: 'Number of Deals',
                                    font: { size: 12 }
                                },
                                ticks: {
                                    stepSize: 1
                                },
                                grid: {
                                    color: '#f0f0f0'
                                }
                            },
                            x: {
                                grid: {
                                    display: false
                                }
                            }
                        }
                    }
                });
            }

            // ==========================================
            // 3. MONTHLY SALES LINE/AREA CHART
            // ==========================================
            const salesCtx = document.getElementById('monthlySalesChart');
            if (salesCtx) {
                new Chart(salesCtx, {
                    type: 'line',
                    data: {
                        labels: monthlySalesData.Months,
                        datasets: [{
                            label: 'Won Revenue ($)',
                            data: monthlySalesData.Revenue,
                            fill: true,
                            backgroundColor: 'rgba(25, 135, 84, 0.12)',
                            borderColor: '#198754',
                            borderWidth: 3,
                            tension: 0.35,
                            pointBackgroundColor: '#198754',
                            pointBorderColor: '#ffffff',
                            pointBorderWidth: 2,
                            pointRadius: 5,
                            pointHoverRadius: 7
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: {
                                    boxWidth: 14,
                                    font: { size: 12, weight: 'bold' }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const val = context.parsed.y || 0;
                                        const index = context.dataIndex;
                                        const count = monthlySalesData.WonDealsCount[index] || 0;
                                        return ` Revenue: $${val.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })} (${count} won deals)`;
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                title: {
                                    display: true,
                                    text: 'Closed Revenue ($)',
                                    font: { size: 12 }
                                },
                                ticks: {
                                    callback: function(value) {
                                        return '$' + value.toLocaleString();
                                    }
                                },
                                grid: {
                                    color: '#f0f0f0'
                                }
                            },
                            x: {
                                grid: {
                                    display: false
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
